---
import InnerLayout from "../layouts/InnerLayout.astro";
import Contact from "../components/Contact.astro";
---

<InnerLayout>
  <main>
    <section id="home" class="home">
      <div class="intro-lines">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="container">
        <div class="container-inner">
          <div class="left">
            <p>BIM CYBERSECURITY</p>
            <div class="title">Digitally Transforming Myanmar</div>
            <p>
              Defending and Protecting your organization through Penetration
              Testing ,Red Teaming, Adversary Simulation and Running breaching
              exercise
            </p>
            <div class="button-container">
              <a href="/pricing">Pricing</a><a href="/#about">About us</a><a
                href="/files/VAPT.pdf"
                download>Brochure (VAPT Services)</a
              ><a href="/files/MSS.pdf" download
                >Brochure (Managed Security Services)</a
              ><a href="/files/27001.pdf" download
                >Brochure (ISO 27001 And IT Governance)</a
              >
            </div>
          </div>
          <div class="right">
            <div class="container">
              <a href="https://youtu.be/CRXRR1jWeUQ?si=z89yXaVxASToNZUV" target="_blank" rel="noopener noreferrer">
                <i class="fa-solid fa-play"></i>
              </a>
            </div>
          </div>
